[Unit]
Description=RamWarden page-out helper
Documentation=https://github.com/ethanrisden/ramwarden
# Optional. Without it the daemon falls back to cgroup reclaim, which needs no
# privileges and does most of the work anyway.
# Started from default.target, not graphical-session.target: COSMIC (and some
# other sessions) never activate graphical-session.target, so a unit wanted only
# by it is enabled but silently never starts after a reboot. Nothing here needs
# a display — the desktop probes tolerate a missing one.
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ramwarden-helper
Restart=on-failure
RestartSec=10
Environment=RAMWARDEN_LOG=info

# The binary carries cap_sys_nice+ep from the package postinst. It is a few
# hundred lines that accept one message shape and make one syscall, which is the
# whole reason it is separate from the daemon.
NoNewPrivileges=no
PrivateTmp=yes

[Install]
WantedBy=default.target
