# Host-only settings. Supply keys through the host secret store, never in Git.
RAMWARDEN_API_PROFILE=production
OPENAI_MODEL_ID=gpt-6-luna
# Required secrets: OPENAI_API_KEY, JEV_API_KEY, MONGODB_URI.
# Also configure RAMWARDEN_SUPPORT_TOKEN to enable the staff ticket queue.
RAMWARDEN_SITE_ORIGIN=https://ramwarden.com
RAMWARDEN_PUBLIC_URL=https://api.ramwarden.com
MONGODB_DATABASE=ramwarden
# Keep live payments disabled until checkout review is complete.
RAMWARDEN_ALLOW_LIVE_PAYMENTS=0

# Shared across API replicas: base64 of 32 random bytes; encrypts short-lived GitHub codes.
# Configure through the deployment secret store. Rotation expires pending GitHub logins.
RAMWARDEN_OAUTH_STATE_KEY=
