RAMWARDEN_API_PROFILE=production
RAMWARDEN_API_BIND=127.0.0.1:8081
RAMWARDEN_SITE_ORIGIN=https://staging.ramwarden.com
RAMWARDEN_PUBLIC_URL=https://api-staging.ramwarden.com
MONGODB_DATABASE=ramwarden_staging
RAMWARDEN_ALLOW_LIVE_PAYMENTS=0
# Inject staging-only JEV_API_KEY, OPENAI_API_KEY, MONGODB_URI,
# RAMWARDEN_SUPPORT_TOKEN, RAMWARDEN_ENTITLEMENT_KEY and email credentials.
# Do not reuse production Mongo credentials or configure live billing.
RAMWARDEN_ENABLE_INSTALL_LINKS=0
