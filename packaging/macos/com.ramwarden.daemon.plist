<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ramwarden.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/ramwarden-daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RAMWARDEN_CONFIG</key>
    <string>__HOME__/.config/ramwarden/config.toml</string>
    <key>RAMWARDEN_LOG</key>
    <string>info</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Background QoS keeps the daemon on the efficiency cores. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/ramwarden.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/ramwarden.log</string>
</dict>
</plist>
