{
  "manifest_version": 3,
  "name": "RamWarden",
  "version": "0.3.1",
  "description": "Free, reversible idle-tab cleanup, with optional desktop RAM and security reports.",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "http://localhost:7823/*",
    "ws://localhost:7823/*",
    "http://100.64.0.0/10",
    "http://*/*",
    "ws://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RamWarden",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ramwarden@local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "activity.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
